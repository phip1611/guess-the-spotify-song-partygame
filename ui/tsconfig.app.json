{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "types": [],
    "paths": {
      // https://stackoverflow.com/questions/58259660/how-to-avoid-module-not-found-error-cant-resolve-tslib-error-when-referen
      "tslib": ["node_modules/tslib"],
      "ng-log": ["src/shims/ng-log"]
    }
  },
  "files": [
    "src/main.ts",
    "src/polyfills.ts"
  ],
  "include": [
    "src/**/*.ts",
    "../common-ts/**/*.ts"
  ],
  "exclude": [
    "src/test.ts",
    "src/**/*.spec.ts"
  ]
}
