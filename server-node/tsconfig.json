{
  "compilerOptions": {
    "incremental": true,
    "strict": false,
    "skipLibCheck": true,
    "useUnknownInCatchVariables": false,
    "target": "ES2022",
    "module": "ES2022",
    "ignoreDeprecations": "6.0",
    "rootDir": "..",
    "baseUrl": "./",
    "outDir": "build",
    "isolatedModules": true,
    "removeComments": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "importHelpers": false,
    "types": [
      "node",
      "express",
      "jest"
    ],
    "typeRoots": [
      "node_modules/@types"
    ]
  },
  "include": [
    "./src/**/*.ts",
    "../common-ts/**/*.ts"
  ]
}
