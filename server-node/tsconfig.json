{
  "compilerOptions": {
    "incremental": true,
    "strict": false,
    "skipLibCheck": true,
    "useUnknownInCatchVariables": false,
    "target": "es2018",
    "module": "commonjs",
    "ignoreDeprecations": "6.0",
    "rootDir": "..",
    "baseUrl": "./",
    "outDir": "build",
    "removeComments": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "moduleResolution": "node",
    "importHelpers": false,
    "types": [
      "node",
      "express",
      "jest"
    ],
    "typeRoots": [
      "node_modules/@types"
    ]
  },
  "include": [
    "./src/**/*.ts",
    "../common-ts/**/*.ts"
  ]
}
